# ==============================================================================
# Crush Lifestyle Fitness Studio - Example Backend Configuration
# Copy to .env and fill your Google Sheets ID, n8n API Key, and Webhook URLs
# ==============================================================================

# 1. Google Sheets Storage (Zero External Database Server Cost)
GYMBRO_STORAGE_BACKEND=google_sheets
GOOGLE_SHEETS_MODE=n8n_bridge
GOOGLE_SHEETS_SPREADSHEET_ID=REPLACE_WITH_GOOGLE_SHEET_ID
GOOGLE_SHEETS_SPREADSHEET_NAME=Crush Lifestyle Fitness Studio
GOOGLE_SHEETS_WORKBOOK_PATH=./data/crush_fitness_sheets_workbook.json
GOOGLE_SHEETS_BRIDGE_WEBHOOK_URL=
GOOGLE_API_KEY=
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# 2. n8n API Access & Auto-Provisioning (GM-01 through GM-05)
N8N_BASE_URL=https://your-n8n-instance.up.railway.app
N8N_API_KEY=
N8N_GOOGLE_SHEETS_CREDENTIAL_ID=
N8N_GOOGLE_SHEETS_CREDENTIAL_NAME=Google Sheets account
NOTIFICATION_CHANNEL=Email
STUDIO_SENDER_EMAIL=crushfitnessstudio@gmail.com
N8N_GMAIL_CREDENTIAL_ID=
N8N_GMAIL_CREDENTIAL_NAME=Gmail account
N8N_WHATSAPP_CREDENTIAL_ID=
N8N_WHATSAPP_CREDENTIAL_NAME=WhatsApp account
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_WHATSAPP_PHONE_NUMBER_ID
N8N_WEBHOOK_SECRET=replace-with-shared-hmac-secret

# Production n8n Webhook URLs
N8N_GM01_SYNC_WEBHOOK_URL=
N8N_GM02_DISPATCH_WEBHOOK_URL=
N8N_GM03_PAYMENT_WEBHOOK_URL=
N8N_GM04_DIGEST_WEBHOOK_URL=
N8N_GM05_AGENT_WEBHOOK_URL=

# 3. Studio, FastAPI, Next.js SaaS Frontend, Razorpay & AI Agent
GYMBRO_APP_NAME=Crush Lifestyle Fitness Studio API
GYMBRO_TIMEZONE=Asia/Kolkata
GYMBRO_GST_RATE=0.18
GYMBRO_API_KEY=
FASTAPI_PUBLIC_URL=https://your-fastapi-backend.up.railway.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

# Optional LLM Tool-Calling Engine (built-in deterministic ReAct engine runs when blank)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
